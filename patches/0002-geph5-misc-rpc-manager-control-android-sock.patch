Subject: [PATCH 2/9] geph5-misc-rpc: dual-mode control-socket resolution on Android

Android has no writable /run, so the unix default of /run/geph/control.sock
cannot be created. The socket now resolves through android_state_dir(), a
runtime resolver shared with platform.rs's state_dir(): the
root/KernelSU-Magisk module gets /data/adb/geph5, an unprivileged Termux
service (termux-services/runit, packaged by android/termux/) gets
$HOME/.geph5, and GEPH5_STATE_DIR overrides both for tests and rescue
shells. Sharing one resolver means the socket can never drift away from the
state it describes.

This forced MANAGER_CONTROL_SOCK from a const into manager_control_sock(),
so the patch now also touches its two call sites (the transport dialer in
this file; serve_manager in platform.rs). Fragility stays low: the
resolution logic is an additive cfg arm, and conflicts only arrive if
upstream restructures the socket constants themselves.

android_state_dir() needs libc::geteuid(); the android-only libc dependency
lives in patch 0007.

---
 1 file changed, 47 insertions(+), 6 deletions(-)

diff --git a/libraries/geph5-misc-rpc/src/manager_control.rs b/libraries/geph5-misc-rpc/src/manager_control.rs
index 62f5916..cac325a 100644
--- a/libraries/geph5-misc-rpc/src/manager_control.rs
+++ b/libraries/geph5-misc-rpc/src/manager_control.rs
@@ -9,16 +9,57 @@
 //! status/stats/exits/logs through to the child's own control protocol.
 
 use async_trait::async_trait;
+use std::path::PathBuf;
 use geph5_broker_protocol::ExitConstraint;
 use nanorpc::nanorpc_derive;
 use serde::{Deserialize, Serialize};
 
 /// Filesystem path of the manager's control socket.
-#[cfg(target_os = "macos")]
-pub const MANAGER_CONTROL_SOCK: &str = "/var/run/geph/control.sock";
-/// Filesystem path of the manager's control socket.
-#[cfg(all(unix, not(target_os = "macos")))]
-pub const MANAGER_CONTROL_SOCK: &str = "/run/geph/control.sock";
+pub fn manager_control_sock() -> PathBuf {
+    #[cfg(target_os = "macos")]
+    {
+        PathBuf::from("/var/run/geph/control.sock")
+    }
+    #[cfg(all(unix, not(any(target_os = "macos", target_os = "android"))))]
+    {
+        PathBuf::from("/run/geph/control.sock")
+    }
+    // Android has no writable /run; the socket lives in the resolved state
+    // directory (root module area or the Termux home, see `android_state_dir`).
+    #[cfg(target_os = "android")]
+    {
+        android_state_dir().join("control.sock")
+    }
+    #[cfg(not(unix))]
+    {
+        PathBuf::new()
+    }
+}
+
+/// Resolve geph5's persistent state directory on Android.
+///
+/// One binary serves two install modes: the KernelSU/Magisk root module, whose
+/// data lives in the root-owned `/data/adb/geph5`, and an unprivileged Termux
+/// install managed by termux-services, whose data lives under `$HOME/.geph5`.
+/// Precedence: the `GEPH5_STATE_DIR` override, then euid (root → module area),
+/// then `$HOME` (Termux), and finally the root path if nothing else is known.
+#[cfg(target_os = "android")]
+pub fn android_state_dir() -> PathBuf {
+    if let Some(dir) = std::env::var_os("GEPH5_STATE_DIR")
+        && !dir.is_empty()
+    {
+        return PathBuf::from(dir);
+    }
+    if unsafe { libc::geteuid() } == 0 {
+        return PathBuf::from("/data/adb/geph5");
+    }
+    if let Some(home) = std::env::var_os("HOME")
+        && !home.is_empty()
+    {
+        return PathBuf::from(home).join(".geph5");
+    }
+    PathBuf::from("/data/adb/geph5")
+}
 /// Name of the manager's control named pipe.
 #[cfg(windows)]
 pub const MANAGER_CONTROL_PIPE: &str = r"\\.\pipe\geph-manager-control";
@@ -35,7 +76,7 @@ pub fn manager_control_transport() -> ManagerTransport {
     #[cfg(unix)]
     {
         nanorpc_sillad::DialerTransport(sillad::unix::UnixDialer {
-            path: MANAGER_CONTROL_SOCK.into(),
+            path: manager_control_sock(),
         })
     }
     #[cfg(windows)]
